{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sneakercreepers/creep/blob/main/docs/schemas/report-v1.json",
  "title": "creep JSON report, schema_version 1",
  "description": "Written by creep's JSON report format. There is no version 2: version 1 changes additively only (an optional field or a new enum value, never a removed or retyped field), and a committed fixture per version must stay valid (internal/report contract test). Consumers must accept enum values they do not know; the reason unchanged appears only in a --changed run (ADR 0009, #26 amendment).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool", "run", "findings", "coverage", "data_handling"],
  "properties": {
    "schema_version": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "const": "creep" },
        "version": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "run": {
      "description": "An incomplete run is never a clean result, whatever its findings say; creep exits 4 for it (ADR 0007).",
      "type": "object",
      "additionalProperties": false,
      "required": ["incomplete"],
      "properties": {
        "incomplete": { "type": "boolean" },
        "reason": { "$ref": "#/definitions/id" }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "not_evaluated"],
      "properties": {
        "classes": {
          "type": "array",
          "items": { "$ref": "#/definitions/classCoverage" }
        },
        "not_evaluated": {
          "type": "array",
          "items": { "$ref": "#/definitions/notEvaluated" }
        },
        "scanners": {
          "description": "Optional external scanners and the classes they cover. Only status evaluated means the scanner ran offline and evaluated its classes; failed means it ran and evaluated nothing, which makes the run incomplete (ADR 0010, ADR 0013).",
          "type": "array",
          "items": { "$ref": "#/definitions/scannerCoverage" }
        },
        "not_looked_for": {
          "description": "Vulnerability classes no creep scan looks for, in any language or tier, so the report says nothing about them. Always written since #365; a report written before it has none (ADR 0034).",
          "type": "array",
          "items": { "$ref": "#/definitions/notLookedFor" }
        }
      }
    },
    "data_handling": { "$ref": "#/definitions/dataHandling" }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "count": { "type": "integer", "minimum": 0 },
    "counts": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/count" }
    },
    "path": {
      "description": "Repository-relative path, taken from the scanned repository: untrusted, escape before printing.",
      "type": "string",
      "minLength": 1
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "class", "status", "path", "line"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "class": { "$ref": "#/definitions/id" },
        "status": { "enum": ["verified", "probable", "discarded", "not_evaluated"] },
        "path": { "$ref": "#/definitions/path" },
        "line": { "description": "1-based; 0 means the whole file.", "$ref": "#/definitions/count" },
        "reason": { "description": "Why a not-evaluated finding was not decided (ADR 0009).", "$ref": "#/definitions/id" },
        "partial": { "description": "The verdict came from a slice that left lines out: partial coverage, never clean.", "type": "boolean" },
        "confidence": { "description": "The reader's confidence, 0-100.", "type": "integer", "minimum": 0, "maximum": 100 },
        "evidence": {
          "description": "Line ranges of the finding's file that the reader cited.",
          "type": "array",
          "items": { "$ref": "#/definitions/lineRange" }
        },
        "fingerprint": { "description": "A probable or verified finding's identity across runs and line moves: a hash of its class, path and redacted sink line, or of an optional scanner's rule (ADR 0022). Added to v1 additively by #27.", "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "suppression": { "$ref": "#/definitions/suppression" },
        "stability": { "$ref": "#/definitions/stability" },
        "unreliable_model": { "description": "The model that decided the finding failed the calibration fitness floor, and the scan ran anyway with --allow-unfit-model (ADR 0036). Absent otherwise. Added to v1 additively by #363.", "const": true }
      }
    },
    "stability": {
      "description": "How many samples of a --stability N run saw a probable or verified finding: its discovery named the sink and its reader answered vulnerable (ADR 0024). Seen below runs is an unstable discovery, a property of the model, distinct from an intermittent PoC (ADR 0020), which is not in JSON. Added to v1 additively by #37.",
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "seen", "unstable"],
      "properties": {
        "runs": { "type": "integer", "minimum": 2, "maximum": 5 },
        "seen": { "type": "integer", "minimum": 0, "maximum": 5 },
        "unstable": { "description": "seen < runs.", "type": "boolean" }
      }
    },
    "suppression": {
      "description": "The baseline entry that keeps a probable or verified finding from the gate until it expires (ADR 0022). The finding is still listed; a not-evaluated finding is never suppressed. Added to v1 additively by #27.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expires"],
      "properties": {
        "kind": { "enum": ["baseline", "accepted"] },
        "expires": { "description": "The first UTC day the entry no longer suppresses.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reason": { "description": "An accepted risk's reason, from the baseline file the scanned repository holds: untrusted, escape before printing. One printable line of at most 200 bytes.", "type": "string", "minLength": 1 }
      }
    },
    "lineRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "classCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "status", "detected", "tasks", "ci_low", "ci_high"],
      "properties": {
        "class": { "$ref": "#/definitions/id" },
        "status": { "enum": ["covered", "partial", "not_evaluated"] },
        "detected": { "$ref": "#/definitions/count" },
        "tasks": { "$ref": "#/definitions/count" },
        "ci_low": { "type": "number", "minimum": 0, "maximum": 1 },
        "ci_high": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "notLookedFor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "cwe"],
      "properties": {
        "class": { "$ref": "#/definitions/id" },
        "cwe": { "type": "string", "pattern": "^CWE-[1-9][0-9]{0,4}$" }
      }
    },
    "scannerCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "classes"],
      "properties": {
        "name": { "$ref": "#/definitions/id" },
        "status": { "enum": ["not_enabled", "missing", "refused", "not_run", "evaluated", "failed"] },
        "classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/id" } }
      }
    },
    "notEvaluated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason"],
      "properties": {
        "path": { "type": "string" },
        "reason": { "enum": ["read_failed", "too_large", "line_too_long", "redact_failed", "run_full", "send_failed", "budget", "lines_shifted", "vendor", "generated", "minified", "not_regular", "invalid_path", "parse_failed", "syntax_error", "truncated", "unsupported_language", "unchanged"] }
      }
    },
    "dataHandling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "bytes", "endpoints", "redactions"],
      "properties": {
        "requests": { "$ref": "#/definitions/count" },
        "bytes": { "$ref": "#/definitions/count" },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/endpointUsage" }
        },
        "redactions": { "$ref": "#/definitions/counts" }
      }
    },
    "endpointUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "models", "requests", "bytes", "input_tokens", "output_tokens", "outcomes"],
      "properties": {
        "endpoint": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string" } },
        "requests": { "$ref": "#/definitions/count" },
        "bytes": { "$ref": "#/definitions/count" },
        "input_tokens": { "$ref": "#/definitions/count" },
        "output_tokens": { "$ref": "#/definitions/count" },
        "outcomes": { "$ref": "#/definitions/counts" }
      }
    }
  }
}
