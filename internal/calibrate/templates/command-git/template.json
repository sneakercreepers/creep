{
  "version": 2,
  "id": "command-git",
  "class": "command_injection",
  "pad_after": 0,
  "slots": {
    "func": ["show_log", "branch_log", "list_commits", "history", "recent_changes", "commit_log"],
    "field": ["branch_name", "ref", "rev", "refname", "head", "tag"]
  },
  "vulnerable": {"sink_line": 4, "marker": "shell(\"git log"},
  "safe": {"sink_line": 6, "marker": "run_process([\"git\""}
}
