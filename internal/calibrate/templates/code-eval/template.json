{
  "version": 2,
  "id": "code-eval",
  "class": "code_injection",
  "pad_after": 0,
  "slots": {
    "func": ["calculate", "compute", "evaluate_sum", "quote_price", "convert_units", "estimate"],
    "field": ["expr", "formula_text", "amount", "value", "input_expr", "calc"]
  },
  "vulnerable": {"sink_line": 3, "marker": "eval(expression)"},
  "safe": {"sink_line": 3, "marker": "to_number(expression)"}
}
