{
  "version": 2,
  "id": "sqli-concat",
  "class": "sqli",
  "pad_after": 0,
  "slots": {
    "func": ["search_notes", "find_posts", "lookup_titles", "list_entries", "filter_records", "match_items"],
    "field": ["needle", "keyword", "phrase", "text_filter", "q", "words"],
    "table": ["notes", "posts", "entries", "articles", "records", "items"]
  },
  "vulnerable": {"sink_line": 4, "marker": "db.query(sql)"},
  "safe": {"sink_line": 4, "marker": "db.query(sql, [term])"}
}
