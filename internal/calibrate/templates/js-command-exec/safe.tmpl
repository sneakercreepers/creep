const express = require("express");
const { execFile } = require("child_process");
const router = express.Router();
const ARCHIVE_ROOTS = new Map([["web", "/srv/app/web"], ["docs", "/srv/app/docs"]]);

router.get("/@@route@@", (req, res) => {
  const root = ARCHIVE_ROOTS.get(req.query.@@field@@);
  if (!root) return res.sendStatus(404);
  execFile("tar", ["-czf", "/tmp/out.tgz", "--", root], (err) => res.sendStatus(err ? 500 : 200));
});

module.exports = router;
