from urllib.parse import urlsplit, urlunsplit

import requests
from flask import Flask, abort, request

app = Flask(__name__)
ALLOWED_HOSTS = {"media.example.invalid"}


@app.route("/@@route@@")
def @@func@@():
    raw = request.args.get("@@field@@", "")
    parts = urlsplit(raw)
    if parts.scheme != "https" or parts.hostname not in ALLOWED_HOSTS:
        abort(400)
    rebuilt = urlunsplit(("https", parts.hostname, parts.path, parts.query, ""))
    return requests.get(rebuilt, timeout=5, allow_redirects=False).text
