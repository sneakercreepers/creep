import subprocess

from flask import Flask, abort, request

app = Flask(__name__)
LOOKUP_NAMES = {"db": "db.lab.example.invalid", "cache": "cache.lab.example.invalid"}


@app.route("/@@route@@")
def @@func@@():
    fqdn = LOOKUP_NAMES.get(request.args.get("@@field@@", ""))
    if fqdn is None:
        abort(404)
    cmd = ["nslookup", "--", fqdn]
    return subprocess.run(cmd, shell=False, capture_output=True).stdout
