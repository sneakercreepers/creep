const express = require("express");
const db = require("./db");
const router = express.Router();
const { requireLogin } = require("./auth");

router.get("/@@route@@", requireLogin, (req, res) => {
  const sql = "SELECT * FROM @@table@@ WHERE owner = ? AND label = ?";
  db.query(sql, [req.session.ownerId, String(req.query.@@field@@ ?? "")], (err, rows) => res.json(rows));
});

module.exports = router;
