{
  "version": 2,
  "id": "deserialize-job",
  "class": "insecure_deserialization",
  "pad_after": 0,
  "slots": {
    "func": ["enqueue", "import_job", "submit_task", "schedule", "queue_work", "accept_job"],
    "queue": ["imports", "batch", "nightly", "exports_q", "workers", "backlog"]
