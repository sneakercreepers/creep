{
  "version": 2,
  "id": "command-lookup",
  "class": "command_injection",
  "pad_after": 0,
  "slots": {
    "func": ["resolve_domain", "dns_lookup", "check_dns", "query_name", "lookup_host", "name_info"],
    "field": ["domain_name", "target", "fqdn", "hostname", "server", "zone"]
  },
  "vulnerable": {"sink_line": 3, "marker": "shell(\"nslookup \" + domain)"},
  "safe": {"sink_line": 5, "marker": "run_process([\"nslookup\", domain])"}
}
